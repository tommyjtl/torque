index 61d6171..b70f16f 100644
--- a/common/world.c
+++ b/common/world.c
@@ -479,6 +479,40 @@ SV_LinkEdict(edict_t *ent, qboolean touch_triggers)
 	SV_TouchLinks(ent, sv_areanodes);
 }
 
+/* Capture exact membership and iteration order. QuakeC can change .solid
+ * between relinks, so recomputing a bucket from the current field loses state. */
+void mq_capture_links(int *codes)
+{
+    for (int i = 0; i < sv.num_edicts; ++i) codes[i] = -1;
+    for (int i = 0; i < sv_numareanodes; ++i) {
+        for (int type = 0; type < 2; ++type) {
+            link_t *head = type ? &sv_areanodes[i].trigger_edicts : &sv_areanodes[i].solid_edicts;
+            int rank = 0;
+            for (link_t *p = head->next; p != head; p = p->next) {
+                edict_t *e = (edict_t *)((byte *)p - offsetof(edict_t, area));
+                codes[NUM_FOR_EDICT(e)] = (2*i + type)*MAX_EDICTS + rank++;
+            }
+        }
+    }
+}
+
+int mq_link_code_valid(int code, int count)
+{
+    return code == -1 || (code >= 0 && code / MAX_EDICTS < 2*((1 << (AREA_DEPTH+1))-1) &&
+                          code % MAX_EDICTS < count);
+}
+
+void mq_restore_link(edict_t *e, int code)
+{
+    e->num_leafs = 0;
+    if (e == sv.edicts || e->free) return;
+    if (e->v.modelindex) SV_FindTouchedLeafs(e, sv.worldmodel->nodes);
+    if (code < 0) return;
+    int bucket = code / MAX_EDICTS;
+    areanode_t *node = &sv_areanodes[bucket/2];
+    InsertLinkBefore(&e->area, (bucket & 1) ? &node->trigger_edicts : &node->solid_edicts);
+}
