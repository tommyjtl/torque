/* Read the original text save format generated by the earlier desktop build.
 * Validate against the installed QuakeC definitions before leaving a game. */
static qboolean mq_legacy_line(FILE *f, char *line, size_t size)
{
    if (!fgets(line, size, f))
        return false;
    char *end = strchr(line, '\n');
    if (!end || !*line)
        return false;
    *end = 0;
    if (end > line && end[-1] == '\r')
        end[-1] = 0;
    return line[0] != 0;
}

static qboolean mq_numbers(const char *s, int count)
{
    for (int i = 0; i < count; ++i) {
        char *end;
        double value = strtod(s, &end);
        if (s == end || !isfinite(value))
            return false;
        s = end;
    }
    while (isspace((unsigned char)*s))
        ++s;
    return !*s;
}

static const char *mq_quoted(const char **cursor)
{
    const char *s = *cursor;
    while (isspace((unsigned char)*s))
        ++s;
    if (*s++ != '"')
        return NULL;
    const char *end = strchr(s, '"');
    if (!end)
        return NULL;
    *cursor = end + 1;
    return s;
}

static qboolean mq_legacy_value(const dprograms_t *program, qboolean global, const char *name,
                                const char *value, int *largest_ref)
{
    const byte *base = (const byte *)program;
    const char *strings = (const char *)base + program->ofs_strings;
    const ddef_t *fields = (const ddef_t *)(base + program->ofs_fielddefs);
    const ddef_t *defs = global ? (const ddef_t *)(base + program->ofs_globaldefs) : fields;
    int count = global ? program->numglobaldefs : program->numfielddefs;
    for (int i = 0; i < count; ++i) {
        if (strcmp(name, strings + defs[i].s_name))
            continue;
        switch (defs[i].type & ~DEF_SAVEGLOBAL) {
        case ev_entity: {
            char *end;
            long ref = strtol(value, &end, 10);
            if (!value[0] || *end || ref < 0 || ref >= MAX_EDICTS)
                return false;
            if (ref > *largest_ref)
                *largest_ref = ref;
            return true;
        }
        case ev_vector:
            return strlen(value) < 127 && mq_numbers(value, 3);
        case ev_float:
            return mq_numbers(value, 1);
        case ev_function: {
            const dfunction_t *fn = (const dfunction_t *)(base + program->ofs_functions);
            for (int j = 0; j < program->numfunctions; ++j)
                if (!strcmp(value, strings + fn[j].s_name))
                    return true;
            return false;
        }
        case ev_field:
            for (int j = 0; j < program->numfielddefs; ++j)
                if (!strcmp(value, strings + fields[j].s_name))
                    return true;
            return false;
        default:
            return true;
        }
    }
    // Upstream text saves can carry extra keys from other engine versions.
    return true;
}

static qboolean mq_legacy_body(const char *s, const dprograms_t *program, const char *map)
{
    int blocks = 0, largest_ref = 0;
    qboolean world = false, identity = false, player = false;
    while (*s) {
        while (isspace((unsigned char)*s))
            ++s;
        if (!*s)
            break;
        if (*s++ != '{' || blocks > MAX_EDICTS)
            return false;
        const char *start = s;
        for (;;) {
            while (isspace((unsigned char)*s))
                ++s;
            if (*s == '}') {
                ++s;
                break;
            }
            char name[64], value[1024];
            const char *key = mq_quoted(&s);
            if (!key || s - key - 1 >= sizeof name)
                return false;
            memcpy(name, key, s - key - 1);
            name[s - key - 1] = 0;
            const char *v = mq_quoted(&s);
            if (!v || s - v - 1 >= sizeof value)
                return false;
            memcpy(value, v, s - v - 1);
            value[s - v - 1] = 0;
            if (strchr(value, '}') || !mq_legacy_value(program, !blocks, name, value, &largest_ref))
                return false;
            if (blocks == 1 && !strcmp(name, "classname") && !strcmp(value, "worldspawn"))
                world = true;
            if (blocks == 1 && !strcmp(name, "model") && !strcmp(value, map))
                identity = true;
            if (blocks == 2 && !strcmp(name, "classname") && !strcmp(value, "player"))
                player = true;
        }
        if (s - start >= 32766)
            return false;
        ++blocks;
    }
    return blocks >= 3 && largest_ref < blocks - 1 && world && identity && player;
}

static qboolean mq_legacy_valid(FILE *file)
{
    char line[1024], map[MAX_QPATH];
    long start = ftell(file);
    if (!mq_legacy_line(file, line, sizeof line))
        return false;
    for (int i = 0; i < NUM_SPAWN_PARMS; ++i)
        if (!mq_legacy_line(file, line, sizeof line) || !mq_numbers(line, 1))
            return false;
    if (!mq_legacy_line(file, line, sizeof line) || !mq_numbers(line, 1) || atof(line) < 0 ||
        atof(line) > 3)
        return false;
    if (!mq_legacy_line(file, line, sizeof line) || !mq_map_path(line, map))
        return false;
    uint32_t checksum;
    if (!mq_asset(map, &checksum, NULL, 0) || !mq_legacy_line(file, line, sizeof line) ||
        !mq_numbers(line, 1) || atof(line) < 0)
        return false;
    for (int i = 0; i < MAX_LIGHTSTYLES; ++i)
        if (!mq_legacy_line(file, line, sizeof line) ||
            strspn(line, "abcdefghijklmnopqrstuvwxyz") != strlen(line))
            return false;
    long body = ftell(file);
    if (body < 0 || fseek(file, 0, SEEK_END))
        return false;
    long size = ftell(file) - body;
    if (size < 1 || size > MQ_MAX_SAVE || fseek(file, body, SEEK_SET))
        return false;
    char *text = malloc(size + 1);
    if (!text)
        return false;
    text[size] = 0;
    size_t ncode;
    const dprograms_t *code = COM_LoadTempFile("progs.dat", &ncode);
    qboolean ok = code && ncode >= sizeof(*code) && code->version == 6 &&
                  fread(text, 1, size, file) == (size_t)size && !memchr(text, 0, size) &&
                  mq_legacy_body(text, code, map);
    free(text);
    return ok && !fseek(file, start, SEEK_SET);
}
